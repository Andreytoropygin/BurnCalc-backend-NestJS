<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Login</title>
</head>
<body>
  <h1>Вход</h1>
  <form method="POST" action="/api/users/login">
    <label>Name:</label><br>
    <input type="name" name="name" required><br><br>
    <label>Password:</label><br>
    <input type="password" name="password" required><br><br>
    <button type="submit">Login</button>
  </form>
</body>
</html>