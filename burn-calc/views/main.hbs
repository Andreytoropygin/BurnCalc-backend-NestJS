<!DOCTYPE html>
<html lang="ru">
{{> head}}
<body>
    {{> header}}
    <main class="main-content">
        <div class="container">
            <div class="search-container">
                <form action="/burn-calc" method="POST" class="search-form">
                    <input type="text" class="search-input" name="query" placeholder="Введите запрос" value="{{query}}">
                    <button type="submit" class="search-input-button">🔎</button>
                </form>
            </div>
            <div class="combustions-grid">
                {{#each combustions}}
                    <!-- Карточка товара -->
                    <div class="combustion-card">
                        <a href="/burn-calc/combustion/{{this.id}}">
                            <div class="combustion-card-container">
                                <div class="combustion-image">
                                    <img src="/images/{{this.image_file_name}}" alt="Модель молекулы">
                                </div>
                                <p class="combustion-title">{{this.title}}</p>
                                <p class="combustion-formula">{{this.formula}}</p>
                                <form action="/burn-calc/add-to-request" method="POST" class="add-to-request-form">
                                    <input type="hidden" name="combustionId" value="{{this.id}}">
                                    <!-- Указываем, что вернуться нужно на главную -->
                                    <input type="hidden" name="redirectTo" value="/burn-calc">
                                    <button type="submit" class="btn btn-primary">Добавить в заявку</button>
                                </form>
                            </div>
                        </a>
                    </div>
                {{/each}}
            </div>
        </div>
    </main>

    {{#if has_draft}}
        <a href="/burn-calc/request/{{request_id}}">
            <div class="request-widget request-widget-active">
                <i class="fas fa-shopping-cart"></i>
                <span class="request-count">{{request_count}}</span>
            </div>
        </a>
    {{else}}
        <div class="request-widget request-widget-unactive">
            <i class="fas fa-shopping-cart"></i>
        </div>
    {{/if}}
</body>
</html>