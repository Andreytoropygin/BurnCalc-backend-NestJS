<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Profile</title>
</head>
<body>
    <h1>Профиль</h1>
    <p>Имя: {{ user.name }}</p>
    {{#if user.isModerator}}
        <p>Роль: модератор</p>
    {{else}}
        <p>Роль: пользователь</p>
    {{/if}}
    <form action="/api/users/logout" method="POST">
        <button type="submit">Выход</button>
    </form>
</body>
</html>