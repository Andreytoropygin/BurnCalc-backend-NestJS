<!DOCTYPE html>
<html lang="ru">
{{> head}}
<body>
    {{> header}}
    <main class="main-content">
        <div class="container compound-page-container">
            
            {{#if compound}}
                <!-- Левая колонка: Видео -->
                <div class="media-column">
                    <div class="media-wrapper">
                        <video autoplay loop muted controls width="100%" class="media-placeholder">
                            <source src="/videos/{{compound.video_file_name}}" type="video/mp4">
                        </video>
                        <!-- Кнопки взаимодействия (лайк, коммент, закладка) -->
                        <div class="interaction-buttons">
                            <button class="interaction-btn"><i class="far fa-heart"></i><span>{{compound.likes}}</span></button>
                            <button class="interaction-btn"><i class="far fa-comment-dots"></i><span>{{compound.comments}}</span></button>
                            <button class="interaction-btn"><i class="far fa-bookmark"></i><span>{{compound.bookmarks}}</span></button>
                        </div>
                    </div>
                </div>

                <!-- Правая колонка: Информация о соединении -->
                <div class="info-column">
                    <div class="compound-info-card">
                        <p class="compound-info-card-title">{{compound.title}}</p>
                        <div class="compound-info-card-content">
                            <div class="tabs">
                                <button class="tab-btn active">Описание</button>
                                <button class="tab-btn">Комментарии</button>
                            </div>

                            <div class="tab-content">
                                <table class="properties-table">
                                    <tbody>
                                        <tr>
                                            <td>Класс</td>
                                            <td>{{compound.class}}</td>
                                        </tr>
                                        <tr>
                                            <td>Молярная масса</td>
                                            <td>{{compound.molar_mass}} г/моль</td>
                                        </tr>
                                        <tr>
                                            <td>Брутто-формула</td>
                                            <td>{{compound.formula}}</td>
                                        </tr>
                                    </tbody>
                                </table>

                                <div class="molecule-image">
                                    <img src="/images/{{compound.image_file_name}}" alt="Модель молекулы">
                                </div>

                                <p class="description-text">{{compound.description}}</p>
                            </div>

                            <button class="add-to-request-btn">Добавить в заявку</button>
                        </div>
                    </div>
                </div>
            {{else}}
                <h2>{{title}}</h2>
            {{/if}}

        </div>
    </main>

</body>
</html>