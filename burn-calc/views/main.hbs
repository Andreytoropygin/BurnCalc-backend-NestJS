<!DOCTYPE html>
<html lang="ru">
{{> head}}
<body>
    {{> header}}
    <main class="main-content">
        <div class="container">
            <div class="search-container">
                <form action="/burn-calc" method="POST">
                    <input type="text" class="search-input" name="query" placeholder="Введите запрос" value="{{query}}">
                    <button type="submit" class="search-input-button">🔎</button>
                </form>
            </div>
            <div class="combustions-grid">
                {{#each combustions}}
                    <!-- Карточка товара -->
                    <div class="combustion-card">
                        <a href="/burn-calc/combustion/{{this.id}}">
                            <div class="combustion-card-container">
                                <div class="combustion-image">
                                    <img src="/images/{{this.image_file_name}}" alt="Модель молекулы">
                                </div>
                                <p class="combustion-title">{{this.title}}</p>
                                <p class="combustion-formula">{{this.formula}}</p>
                            </div>
                        </a>
                    </div>
                {{/each}}
            </div>
        </div>
    </main>

    <a href="/burn-calc/request/1">
        <div class="cart-widget">
            <i class="fas fa-shopping-cart"></i>
            <span class="cart-count">{{cart_count}}</span>
        </div>
    </a>
</body>
</html>