<!DOCTYPE html>
<html lang="ru">
{{> head}}
<body>
    {{> header}}
    <main class="main-content">
        <div class="container">
            <div class="search-container">
                <form action="/burn-calc" method="POST" class="search-form">
                    <input type="text" class="search-input" name="query" placeholder="Введите запрос" value="{{query}}">
                    <button type="submit" class="search-input-button">🔎</button>
                </form>
            </div>
            <div class="compounds-grid">
                {{#each compounds}}
                    <!-- Карточка товара -->
                    <div class="compound-card">
                        <div class="compound-image">
                            <img src="/images/{{this.imageFileName}}" alt="Модель молекулы">
                        </div>
                        <p class="compound-title">{{this.title}}</p>
                        <p class="compound-formula">{{this.formula}}</p>
                        <div class="card-buttons">
                            <a href="/burn-calc/compound/{{this.id}}">
                                <button class="btn btn-primary">Подробнее</button>
                            </a>
                            <form action="/burn-calc/add-to-cart" method="POST">
                                <input type="hidden" name="compoundId" value="{{this.id}}">
                                <!-- Указываем, что вернуться нужно на главную -->
                                <input type="hidden" name="redirectTo" value="/burn-calc">
                                <button type="submit" class="btn btn-primary">Добавить в заявку</button>
                            </form>
                        </div>
                    </div>
                {{/each}}
            </div>
        </div>
    </main>
    {{#if has_draft}}
        <a href="/burn-calc/request/{{cart_id}}">
            <div class="cart-widget">
                <i class="fas fa-shopping-cart"></i>
                <span class="cart-count">{{cart_count}}</span>
            </div>
        </a>
    {{else}}
        <div class="cart-widget">
            <i class="fas fa-shopping-cart"></i>
            <span class="cart-count">{{cart_count}}</span>
        </div>
    {{/if}}
</body>
</html>